# INACTIVE TEMPLATE: deliberately outside .github/workflows and not a .yml file.
# Do not activate, configure Pages, or run deployment without separate owner approval.
# Resolve legal drafts, audience/effective date and all publication gates first.
# Review exact-commit Android/static CI before activation and manual dispatch.
name: Owner-approved Komprexo Pages publication
on:
  workflow_dispatch:
    inputs:
      approved_commit:
        description: Full SHA of the owner-approved, CI-verified publication commit
        required: true
        type: string
      owner_approval:
        description: Type PUBLISH KOMPREXO PAGES only after explicit owner approval
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: komprexo-pages-publication
  cancel-in-progress: false
jobs:
  build:
    if: github.ref == 'refs/heads/work'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - name: Check exact commit and publication approval
        env:
          APPROVED_COMMIT: ${{ inputs.approved_commit }}
          OWNER_APPROVAL: ${{ inputs.owner_approval }}
        run: |
          test "$APPROVED_COMMIT" = "$GITHUB_SHA"
          test "$OWNER_APPROVAL" = 'PUBLISH KOMPREXO PAGES'
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: website/package-lock.json
      - name: Build and check approved public content
        run: |
          python3 scripts/build-static-site.py
          python3 scripts/prepare-pages-artifact.py --publication
          python3 scripts/test-phase4-assets.py
      - name: Browser regression at root and project path
        working-directory: website
        run: |
          npm ci
          npx playwright install --with-deps chromium
          npm test
      # Static relative paths need no configure-pages metadata or auto-enablement.
      # The owner must enable Pages separately after publication approval.
      - uses: actions/upload-pages-artifact@v4
        with:
          path: website/build
  deploy:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy owner-approved site
        id: deployment
        uses: actions/deploy-pages@v4
